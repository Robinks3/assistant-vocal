# Copier en poc/.env et remplir. Ce fichier-ci ne contient aucune valeur secrète.
# Home Assistant : adresse et jeton longue durée (Profil, Sécurité, Jetons d'accès longue durée)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Jeton des téléphones satellites (au moins 16 caractères), compilé dans l'APK de son propriétaire
SATELLITE_JETON=
# Cerveau de repli : claude (API Anthropic) ou local (llama-server compatible OpenAI). Ligne absente : local
# sur le PC, claude dans le profil ha (l'appli Home Assistant n'a pas de carte graphique).
LLM_FOURNISSEUR=claude
ANTHROPIC_API_KEY=
# Modèle Claude (claude-haiku-5-5 par défaut)
#CLAUDE_MODELE=claude-haiku-5-5
LLM_URL=http://127.0.0.1:8080/v1
LLM_MODELE=assistant-vocal
# Micro et sortie du PC (morceau du nom du périphérique), mot de réveil : hey_jarvis ou un mot dont le modèle
# est dans reveil/<mot>.onnx du dossier de configuration (décrit par la section reveil de maison.json)
MICRO=
SORTIE=
MOT_REVEIL=hey_jarvis
# Score du mot de réveil, de 0 à 1 (0,5 par défaut). Écrit par serveur_satellite.py --calibrer.
#SEUIL_REVEIL=0.5
# Voix Piper du PC (chemin d'un .onnx, poc/voix/fr_FR-siwis-medium.onnx par défaut)
#VOIX=
# Transcription en ligne facultative (API compatible OpenAI, par exemple Voxtral chez Mistral)
STT_API_CLE=
STT_API_NOM=Voxtral
# Adresse et modèle de cette API, ceux de Mistral par défaut
#STT_API_URL=https://api.mistral.ai/v1/audio/transcriptions
#STT_API_MODELE=voxtral-mini-latest
# Données de santé pour l'écran de la tablette (serveur du PC seulement, sante-api par Tailscale).
# Jeton : ligne SANTE_JETON de /etc/sante/jeton.env sur le SERVEUR. Vide : relais éteint.
# Le jeton ne part que vers une adresse Tailscale (100.64.0.0/10), vérifiée avant chaque appel.
# Adresse de sante-api, par exemple http://<machine>.<tailnet>.ts.net:8096. Vide : URL_DEFAUT de poc/sante.py.
SANTE_URL=
SANTE_JETON=
# Connexions permises (liaison chiffrée seulement), séparées par des virgules. Ligne absente : le propriétaire
# seul (proprietaire.cle de maison.json), c'est-à-dire le jeton SATELLITE_JETON. Un téléphone appairé s'ajoute
# par « appareil:<id> » (id dans appareils.json), un jeton fixe SATELLITE_JETON_<NOM> par son nom en minuscules.
# Ligne présente mais vide : personne.
#SANTE_PERSONNES=
# Historique de santé (onglets Tendances, Séances, Records et Jour de la tablette), lu dans le
# data-auto.js du tableau de bord HealthStats. Facultatif, valeurs par défaut entre parenthèses.
# Seuil d'une journée active pour la série de pas (6000) et d'une bonne nuit en minutes (420).
SANTE_SEUIL_PAS=6000
SANTE_SEUIL_NUIT_MIN=420
# FC max de référence en bpm pour les bornes des zones, celle de sante-api. Vide : pas de bornes.
SANTE_FC_MAX=
# Météo marine du golfe de Marseille (page « Mer » de la tablette), sources publiques sans clé, aucune
# donnée personnelle. Active par défaut dans les deux profils, METEO_MER=0 l'éteint avec le vent mesuré.
METEO_MER=1
# Vent réellement mesuré dans le golfe de Marseille (page « Vent mesuré » de la tablette) : balises de
# la régate, StationsOfficielles, station de Exemple8. Sources publiques sans clé, aucune donnée
# personnelle. Active par défaut dans les deux profils, VENT_MESURE=0 l'éteint seul.
VENT_MESURE=1
# Serveur des satellites. Profil : pc (serveur du PC, par défaut) ou ha (réglé par l'appli Home Assistant).
#JARVIS_PROFIL=pc
# Port chiffré wss (8766 par défaut, 0 le coupe)
#JARVIS_PORT_TLS=8766
# Ancienne connexion ws://<IP>:8765/?jeton=<jeton> sur le port en clair : 1 (par défaut) la garde le temps
# de mettre à jour tous les téléphones, 0 la refuse.
#JARVIS_ANCIEN_ACCES=1
# Profil ha essayé depuis le PC : 1 joint le serveur Wyoming de Home Assistant par SSH.
#JARVIS_WYOMING_SSH=
# Jeton fixe d'un autre téléphone, nommé par la fin du nom de la variable (au moins 16 caractères)
#SATELLITE_JETON_CAMILLE=

# Les trois variables suivantes sont lues au chargement des modules, avant poc/.env : elles n'ont d'effet
# que dans l'environnement du programme (variable système, ou options de l'appli Home Assistant), pas ici.
# ASSISTANT_VOCAL_CONFIG : dossier de configuration de la maison (config/ par défaut).
# JARVIS_DONNEES : dossier de données de la machine, journaux et phrases apprises (poc/ par défaut).
# VAD_MODELE : modèle Silero VAD (poc/modeles/silero_vad.onnx par défaut).
