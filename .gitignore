# Secrets : jamais dans le dépôt, même privé (jetons HA, satellites, clés Anthropic et transcription)
.env
*.env
!.env.exemple
poc/tls/
poc/appareils.json
*.jks
*.keystore
keystore.properties
*.pem
*.key
*.p12
*.pfx

# Données personnelles produites à l'usage : journaux de commandes, ratés, notes, latences
poc/journal/
journal/
poc/commandes_apprises.yaml
# Export des phrases apprises pour l'APK (android/outils/exporter_dictionnaire.py)
poc/genere/
*.db
*.sqlite
*.sqlite3
*.log

# Environnements et caches
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Android : sorties de compilation et APK (le jeton des satellites y est compilé)
local.properties
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
*.apk
.idea/

# Gros modèles : téléchargés par poc/outils/telecharger_modeles.py (adresse et empreinte SHA-256)
poc/modeles/vision/sface.onnx
android/app/src/main/assets/vision/sface.onnx
poc/voix/*.onnx
poc/voix/*.onnx.json

# Dépôts tiers clonés pour inspiration (ils ont leur propre historique et leur licence)
inspirations/*
!inspirations/comparatif-projet_inspiration.md

# Enregistrements de voix pour les bancs, sons et vidéos (données personnelles)
android/test-canary/
android/test-reveil/
*.wav
# Sons d'écoute synthétisés de l'appli (aucune voix), livrés avec elle
!android/app/src/main/res/raw/ecoute_*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.mp4
*.webm
*.mov

# Poids de LLM et embeddings (visages compris), copiés à part sur les appareils
*.gguf
*.litertlm
*.safetensors
*.npy
*.npz

# Copies de travail des sessions et agents Claude
.claude/worktrees/
# Captures et vidéos de la tablette (appartement, écran) : hors dépôt
docs/captures/

# Rendus des maquettes, régénérés par docs/maquettes/rendre.sh
docs/maquettes/rendus/

# Fichiers système
Thumbs.db
desktop.ini
.DS_Store

